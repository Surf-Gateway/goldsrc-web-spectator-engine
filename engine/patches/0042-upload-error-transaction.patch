diff --git a/ref/gl/gl_image.c b/ref/gl/gl_image.c
--- a/ref/gl/gl_image.c
+++ b/ref/gl/gl_image.c
@@ -1942,7 +1942,10 @@
 	Assert( tex != NULL );
 
 	// catch possible errors
-	if( (gl_check_errors.value || sg_gpu_checking) && ( err = pglGetError()) != GL_NO_ERROR )
+	// Shared uploads retain mandatory before/after transaction checks. Error
+	// flags persist until read, so polling each mip is unnecessary outside
