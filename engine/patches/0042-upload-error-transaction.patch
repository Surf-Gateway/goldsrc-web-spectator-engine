+	if( gl_check_errors.value && ( err = pglGetError()) != GL_NO_ERROR )
 	{
 		if(sg_gpu_checking)sg_gpu_upload_error=true;
 		if(gl_check_errors.value)gEngfuncs.Con_Printf( S_OPENGL_ERROR "%s while uploading %s [%s]\n", GL_ErrorString( err ), tex->name, GL_TargetToString( tex->target ));
