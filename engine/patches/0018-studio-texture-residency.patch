+// The caller excludes colormaps/replacements/alpha-trace sources. Restrict
+// flags and image type too; every unsupported case retains eager loading.
+int GL_LoadStudioTexture( const char *name, const byte *buf, size_t size, int flags )
+{
+    gl_texture_t *tex;
+    rgbdata_t *pic;
+    size_t bytes;
+    int i;
+    if( !r_studio_texture_defer.value || (flags & ~TF_NOMIPMAP) )
+        return GL_LoadTexture( name, buf, size, flags );
+    if( !GL_CheckTexName( name )) return 0;
+    if(( tex = GL_TextureForName( name ))) return tex - gl_textures;
+    // Preflight before owning an image or creating an unregistered GL object.
+    // Below the high-water limit an untouched slot always remains available.
+    if( gl_numTextures >= MAX_TEXTURES )
+    {
+        for( i = 0; i < MAX_TEXTURES && gl_textures[i].texnum; i++ ) {}
+        if( i == MAX_TEXTURES )
+        {
+            gEngfuncs.Host_Error( "Deferred studio texture registry is full\n" );
+            return 0;
+        }
+    }
+    gEngfuncs.Image_SetForceFlags( IL_KEEP_8BIT );
+    pic = gEngfuncs.FS_LoadImage( name, buf, size );
+    if( !pic ) return 0;
+    if( pic->type != PF_INDEXED_32 || !pic->palette || !pic->buffer ||
+        pic->depth != 1 || pic->numMips > 1 ||
+        (pic->flags & ~(IMAGE_HAS_COLOR|IMAGE_HAS_ALPHA|IMAGE_ONEBIT_ALPHA)) )
+    {
+        // Use the owned pack directly; Image_SetMDLPointer is already consumed.
+        int result;
+        GL_ProcessImage( (tex = GL_AllocTexture( name, flags )), pic );
+        if( !GL_UploadTexture( tex, pic ))
+        {
+            GL_DeleteTexture( tex );
+            gEngfuncs.FS_FreeImage( pic );
+            return 0;
+        }
+        GL_ApplyTextureParams( tex );
+        result = tex - gl_textures;
+        gEngfuncs.FS_FreeImage( pic );
+        return result;
+    }
+    bytes = pic->size + 1024; // owned indexed pixels and 32-bit palette
+    if( bytes > SG_STUDIO_PENDING_BUDGET - sg_studio_residency.pendingBytes )
+    {
+        gEngfuncs.FS_FreeImage( pic );
+        gEngfuncs.Host_Error( "Deferred studio texture source budget exceeded\n" );
+        return 0;
+    }
+    // The eager indexed loader detects color from all palette entries. Do the
+    // same scan without expanding pixels, preserving queried metadata/format.
+    for( i = 0; i < 256; i++ )
+    {
+        const byte *c = pic->palette + i * 4;
+        if( c[0] != c[1] || c[1] != c[2] ) { pic->flags |= IMAGE_HAS_COLOR; break; }
+    }
+    tex = GL_AllocTexture( name, flags );
+    tex->studio_pending = pic;
+    tex->studio_pending_bytes = bytes;
+    tex->studio_state = SG_STUDIO_PENDING;
+    sg_studio_residency.pendingBytes += bytes;
+    sg_studio_residency.peakPendingBytes = Q_max( sg_studio_residency.peakPendingBytes, sg_studio_residency.pendingBytes );
+    sg_studio_residency.pendingCount++;
+    sg_studio_residency.reservedTotal++;
+    tex->encode = pic->encode;
+    if( pic->flags & IMAGE_HAS_ALPHA ) tex->flags |= TF_HAS_ALPHA;
+    GL_SetTextureTarget( tex, pic );
+    GL_SetTextureDimensions( tex, pic->width, pic->height, pic->depth );
+    GL_SetTextureFormat( tex, PF_RGBA_32, pic->flags );
+    tex->numMips = GL_CalcMipmapCount( tex, true );
+    // size remains zero until real upload. Metadata queries do not realize.
+    return tex - gl_textures;
 }
 
