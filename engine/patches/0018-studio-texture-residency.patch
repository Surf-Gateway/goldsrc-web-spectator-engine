+// Convert/upload through the original native pipeline exactly once. Keep the
+// pending pointer registered during conversion so Host_Error teardown owns it.
+static qboolean GL_EnsureStudioTexture( gl_texture_t *tex )
+{
+    rgbdata_t *pic;
+    double started;
+    if( tex->studio_state == SG_STUDIO_FAILED || tex->studio_state == SG_STUDIO_RESOLVING )
+    {
+        gEngfuncs.Host_Error( "Deferred studio texture is failed or reentrant\n" );
+        return false;
+    }
+    if( !tex->studio_pending ) return true;
+    started = gEngfuncs.pfnTime();
+    tex->studio_state = SG_STUDIO_RESOLVING;
+    pic = tex->studio_pending;
+    GL_ProcessImage( tex, pic );
+    // The pinned indexed decompressor expands storage but leaves size unchanged.
+    // Eligible MDL images are single-layer RGBA after the original conversion.
+    pic->size = (size_t)pic->width * pic->height * 4;
+    if( pic->type != PF_RGBA_32 || !GL_UploadTexture( tex, pic ))
+    {
+        tex->studio_state = SG_STUDIO_FAILED;
+        sg_studio_residency.failures++;
+        GL_ReleaseStudioSource( tex );
+        GL_StudioResidencyReport();
+        // Preserve the reserved slot until teardown; no stale model index reuse.
+        gEngfuncs.Host_Error( "Deferred studio texture upload failed\n" );
+        return false;
+    }
+    GL_ApplyTextureParams( tex );
+    GL_ReleaseStudioSource( tex );
+    tex->studio_state = SG_STUDIO_RESIDENT;
+    sg_studio_residency.residentCount++;
+    sg_studio_residency.realizedTotal++;
+    sg_studio_residency.lastRealizeMs = (gEngfuncs.pfnTime() - started) * 1000;
+    sg_studio_residency.totalRealizeMs += sg_studio_residency.lastRealizeMs;
+    sg_studio_residency.maxRealizeMs = Q_max( sg_studio_residency.maxRealizeMs, sg_studio_residency.lastRealizeMs );
+    GL_StudioResidencyReport();
+    return true;
+}
