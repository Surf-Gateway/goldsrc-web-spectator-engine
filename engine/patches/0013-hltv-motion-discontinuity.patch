--- a/engine/client/cl_frame.c
+++ b/engine/client/cl_frame.c
@@ -215,6 +215,18 @@
 
 	// compute potential max movement in units per frame and compare with entity movement
 	maxlen = ( clgame.movevars.maxvelocity * ( 1.0f / GAME_FPS ));
+	if( cls.spectator && cls.legacymode == PROTO_GOLDSRC && ent->player )
+	{
+		double interval = ent->curstate.msg_time - ent->prevstate.msg_time;
+		// GoldSrc limits velocity per axis, not vector length. Observed frames
+		// need their real interval; a fixed 20-Hz scalar limit clips fast surf.
+		// Large history gaps and explicit discontinuities must still snap.
+		if( FBitSet( ent->curstate.effects, EF_NOINTERP ) ||
+			!isfinite( interval ) || interval <= 0.0 || interval > 0.25 ||
+			!isfinite( clgame.movevars.maxvelocity ) || clgame.movevars.maxvelocity <= 0.0f )
+			return true;
+		maxlen = clgame.movevars.maxvelocity * interval * 1.7320508075688772 + 0.125;
+	}
 	len = VectorLength( delta );
 
 	return (len > maxlen);
