+void CHudSpectator::EnsureTarget()
+{
+	if( !gEngfuncs.IsSpectateOnly() )
+	{
+		if( sgWebTarget && sgWebTarget->value != 0 ) gEngfuncs.Cvar_SetValue( "_sg_web_target", 0 );
+		return;
+	}
+	// Local browser selection; only an active player can become the camera.
+	if( sgWebRequest && sgWebRequest->value != 0 )
+	{
+		int slot = (int)sgWebRequest->value;
+		gEngfuncs.Cvar_SetValue( "_sg_web_request_target", 0 );
+		if( slot >= 1 && slot <= MAX_PLAYERS && IsActivePlayer( gEngfuncs.GetEntityByIndex( slot ) ) )
+			g_iUser2 = slot;
+	}
+	g_iUser1 = OBS_IN_EYE;
+	m_pip->value = INSET_OFF;
+	if( !IsActivePlayer( gEngfuncs.GetEntityByIndex( g_iUser2 ) ) )
+	{
+		static float lastSearch = -1000.0f;
+		float now = gEngfuncs.GetClientTime();
+		g_iUser2 = 0;
+		// Bound empty-server searches; a rewound clock resets the retry window.
+		if( now < lastSearch || now - lastSearch >= 0.5f )
+		{
+			lastSearch = now;
+			FindNextPlayer( false );
+		}
+	}
+	// The engine reads the cvar string; changing value alone leaves it at zero.
+	if( sgWebTarget && sgWebTarget->value != g_iUser2 ) gEngfuncs.Cvar_SetValue( "_sg_web_target", g_iUser2 );
+}
