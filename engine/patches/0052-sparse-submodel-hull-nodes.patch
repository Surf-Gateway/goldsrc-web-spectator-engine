+/*
+==================
+LastClipNode_r
+
+The highest node a submodel's tree reaches. Editors can leave unused nodes
+between a model's nodes, so a tree may reach past headnode + count. GoldSrc
+does not range-check traces, so such maps (surf_slides_ground) play there.
+Called after CountClipNodes_r, which bounds the walk.
+==================
+*/
+static int LastClipNode16_r( const mclipnode16_t *src, int nodenum, int last )
+{
+	if( nodenum < 0 ) return last;
+	last = Q_max( last, nodenum );
+	last = LastClipNode16_r( src, src[nodenum].children[0], last );
+	return LastClipNode16_r( src, src[nodenum].children[1], last );
+}
+
+static int LastClipNode32_r( const mclipnode32_t *src, int nodenum, int last )
+{
+	if( nodenum < 0 ) return last;
+	last = Q_max( last, nodenum );
+	last = LastClipNode32_r( src, src[nodenum].children[0], last );
+	return LastClipNode32_r( src, src[nodenum].children[1], last );
+}
