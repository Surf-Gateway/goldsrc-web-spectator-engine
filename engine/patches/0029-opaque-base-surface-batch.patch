+      (double)sgBaseWork.nested,(double)sgBaseWork.discardedVerts,
+      (r_base_surface_batch.value!=0)|(sgBaseWork.active<<1)|((sgBaseWork.depth!=0)<<2)|(sgBaseWork.valid<<3)|(sgBaseWork.count<<4),
+      sizeof(sgBaseWork)+sizeof(sgBaseVertices));
+#endif
+}
