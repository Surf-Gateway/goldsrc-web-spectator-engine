+static void SGBaseDiscard(void)
+{
+    sgBaseWork.discardedVerts+=sgBaseWork.count;sgBaseWork.count=sgBaseWork.valid=0;
+}
+static void SGBaseFlush(int reason)
+{
+    uint32_t i;
+    if(sgBaseWork.count){
+        pglBegin(GL_TRIANGLES);
+        for(i=0;i<sgBaseWork.count;i++){
+            pglTexCoord2f(sgBaseVertices[i][3],sgBaseVertices[i][4]);
+            pglVertex3fv(sgBaseVertices[i]);
+        }
+        pglEnd();sgBaseWork.draws++;
+        if(reason==SG_BASE_TEXTURE)sgBaseWork.textureFlushes++;
+        else if(reason==SG_BASE_UPLOAD)sgBaseWork.uploadFlushes++;
+        else if(reason==SG_BASE_SCOPE)sgBaseWork.scopeFlushes++;
+        else if(reason==SG_BASE_CAPACITY)sgBaseWork.capacityFlushes++;
+        else sgBaseWork.unsupportedFlushes++;
+    }
+    sgBaseWork.count=sgBaseWork.valid=0;
+}
+void SGBaseReset(void)
+{
+    if(sgBaseWork.depth)sgBaseWork.abandoned++;
+    SGBaseDiscard();sgBaseWork.active=sgBaseWork.depth=0;
+}
+static void SGBaseBegin(void)
+{
+    if(sgBaseWork.depth){sgBaseWork.nested++;SGBaseDiscard();sgBaseWork.active=0;sgBaseWork.depth++;return;}
+    sgBaseWork.depth=1;sgBaseWork.active=r_base_surface_batch.value!=0;
+}
+static void SGBaseEnd(void)
+{
+    if(sgBaseWork.depth==1)SGBaseFlush(SG_BASE_SCOPE);
+    if(sgBaseWork.depth)sgBaseWork.depth--;
+    if(!sgBaseWork.depth)sgBaseWork.active=sgBaseWork.valid=0;
+}
+static qboolean SGBasePrepare(const msurface_t *fa,const texture_t *texture)
+{
+    const glpoly2_t *poly=fa->polys;
+    gl_texture_t *glt;
+    if(!sgBaseWork.active||sgBaseWork.depth!=1||!r_base_surface_batch.value||!RI.currententity||
+       RI.currententity->curstate.rendermode!=kRenderNormal||!texture||!poly||poly->numverts<3||poly->numverts>8192||
+       FBitSet(fa->flags|poly->flags,SURF_DRAWSKY|SURF_DRAWTURB|SURF_DRAWTILED|SURF_CONVEYOR|SURF_TRANSPARENT)||
+       texture->gl_texturenum<=0||texture->gl_texturenum>=MAX_TEXTURES||glState.activeTMU!=XASH_TEXTURE0){
+        SGBaseFlush(SG_BASE_UNSUPPORTED);return false;
+    }
+    glt=R_GetTexture(texture->gl_texturenum);
+    if(glt->target!=GL_TEXTURE_2D||(glt->studio_state&&glt->studio_state!=SG_STUDIO_RESIDENT)){
+        SGBaseFlush(SG_BASE_UNSUPPORTED);return false;
+    }
+    if(sgBaseWork.count&&glState.currentTexturesIndex[XASH_TEXTURE0]!=(int)sgBaseWork.texture){
+        sgBaseWork.abandoned++;SGBaseDiscard();sgBaseWork.active=0;return false;
+    }
+    if(sgBaseWork.valid&&sgBaseWork.texture!=(uint32_t)texture->gl_texturenum)SGBaseFlush(SG_BASE_TEXTURE);
+    sgBaseWork.texture=texture->gl_texturenum;sgBaseWork.valid=1;return true;
+}
+static qboolean SGBaseAppend(const msurface_t *fa,qboolean eligible)
+{
+    const glpoly2_t *poly=fa->polys;int i,j,k;
+    sgBaseWork.calls++;
+    if(!eligible||!r_base_surface_batch.value||!sgBaseWork.active||sgBaseWork.depth!=1){
+        SGBaseFlush(SG_BASE_UNSUPPORTED);sgBaseWork.fallback++;return false;
+    }
+    if(glState.activeTMU!=XASH_TEXTURE0||glState.currentTexturesIndex[XASH_TEXTURE0]!=(int)sgBaseWork.texture){
+        sgBaseWork.abandoned++;SGBaseDiscard();sgBaseWork.active=0;sgBaseWork.fallback++;return false;
+    }
+    sgBaseWork.batched++;sgBaseWork.originalVerts+=poly->numverts;
+    for(i=1;i+1<poly->numverts;i++){
+        const float *tri[3]={poly->verts[0],poly->verts[i],poly->verts[i+1]};
+        for(j=0;j<3;j++){
+            float *dst=sgBaseVertices[sgBaseWork.count++];
+            for(k=0;k<3;k++)dst[k]=tri[j][k];
+            dst[3]=tri[j][3]+0.0f;dst[4]=tri[j][4]+0.0f;
+        }
+        sgBaseWork.valid=1;sgBaseWork.triangleVerts+=3;
+        if(sgBaseWork.count==SG_BASE_VERTS)SGBaseFlush(SG_BASE_CAPACITY);
+    }
+    return true;
+}
