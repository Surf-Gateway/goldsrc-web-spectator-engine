+/* Owned opaque base pass only: fixed CPU data, no new GPU objects. */
+#include <stdint.h>
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+#endif
+#define SG_BASE_VERTS 3072u
+enum { SG_BASE_TEXTURE,SG_BASE_UPLOAD,SG_BASE_SCOPE,SG_BASE_UNSUPPORTED,SG_BASE_CAPACITY };
+static float sgBaseVertices[SG_BASE_VERTS][5];
+static struct {
+    uint64_t calls,batched,fallback,originalVerts,triangleVerts,draws,textureFlushes,uploadFlushes,scopeFlushes,unsupportedFlushes,capacityFlushes,abandoned,nested,discardedVerts;
+    uint32_t active,depth,count,texture,valid;
