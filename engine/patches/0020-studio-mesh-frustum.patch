+// Test the actual emitted world vertices, before any GL state or texture bind.
+// Unsupported profiles/ranges retain the native path. No source lifetime change.
+static struct { double checked, culled, passed, unsupported, vertexRefs; } sg_mesh_cull;
+void SGStudioMeshCullReport( void )
+{
+#ifdef __EMSCRIPTEN__
+    if( !r_studio_mesh_cull.value ) return;
+    EM_ASM({
+        const s = Module["sgStudioMeshCull"] ??= {};
+        s.checked=$0; s.culled=$1; s.passed=$2; s.unsupported=$3; s.vertexRefs=$4;
+    }, sg_mesh_cull.checked,sg_mesh_cull.culled,sg_mesh_cull.passed,sg_mesh_cull.unsupported,sg_mesh_cull.vertexRefs);
+#endif
+}
+static unsigned int SGStudioVertexClipMask( const float *v )
+{
+    unsigned int mask = 0;
+    int i;
+    for( i = 0; i < FRUSTUM_PLANES; i++ )
+    {
+        const mplane_t *plane = &RI.frustum.planes[i];
+        float margin;
+        if( !(RI.frustum.clipFlags & (1u << i)) ) continue;
+        margin = 0.125f * (fabs(plane->normal[0])+fabs(plane->normal[1])+fabs(plane->normal[2]));
+        if( DotProduct( plane->normal, v ) < plane->dist - margin ) mask |= 1u << i;
+    }
+    return mask;
+}
+static qboolean SGStudioMeshOutside( const mstudiomesh_t *mesh, float shellscale )
+{
+    const studiohdr_t *hdr = m_pStudioHeader;
+    const byte *base = (const byte *)hdr;
+    const short *cmd;
+    const mstudioseqdesc_t *seq;
+    size_t offset, remaining, refs = 0;
+    vec3_t mins, maxs;
+    int count, i, axis;
+    qboolean haveVertex = false;
+    if( !r_studio_mesh_cull.value ) return false;
+    sg_mesh_cull.checked++;
+    if( r_nocull.value || !RP_NORMALPASS() || !RI.drawWorld || RI.currententity == tr.viewent ||
+        RI.currententity->curstate.rendermode != kRenderNormal ||
+        RI.currententity->curstate.renderfx != kRenderFxNone || shellscale != 0.0f ||
+        (g_nFaceFlags & (STUDIO_NF_CHROME|STUDIO_NF_ADDITIVE)) ||
+        !hdr || hdr->flags || hdr->numbones != 1 || hdr->numbonecontrollers ||
+        hdr->numseq != 1 || hdr->numseqgroups != 1 || hdr->length < (int)sizeof(*hdr) || hdr->length > 64*1024*1024 ||
+        hdr->seqindex < (int)sizeof(*hdr) || (hdr->seqindex & 3) || hdr->seqindex > hdr->length ||
+        sizeof(*seq) > (size_t)hdr->length - hdr->seqindex ||
+        m_pSubModel->numverts < 1 || m_pSubModel->numverts > MAXSTUDIOVERTS ||
+        mesh->triindex < (int)sizeof(*hdr) || (mesh->triindex & 1) || mesh->triindex >= hdr->length ) goto unsupported;
+    seq = (const mstudioseqdesc_t *)(base + hdr->seqindex);
+    if( seq->numframes != 1 || seq->numblends != 1 ) goto unsupported;
+    offset = mesh->triindex;
+    ClearBounds( mins, maxs );
+    for( ;; )
+    {
+        remaining = (size_t)hdr->length - offset;
+        if( remaining < sizeof(short) ) goto unsupported;
+        cmd = (const short *)(base + offset);
+        count = *cmd++; offset += sizeof(short);
+        if( count == 0 ) break;
+        if( count < 0 ) count = -count;
+        if( count < 3 || (size_t)count > ((size_t)hdr->length - offset) / (4*sizeof(short)) ||
+            refs + count > 1024u*1024u ) goto unsupported;
+        for( i = 0; i < count; i++, cmd += 4 )
+        {
+            int index = cmd[0];
+            const float *v;
+            if( index < 0 || index >= m_pSubModel->numverts ) goto unsupported;
+            v = g_studio.verts[index];
+            for( axis = 0; axis < 3; axis++ )
+                if( !isfinite(v[axis]) || fabs(v[axis]) > 1048576.0f ) goto unsupported;
+            AddPointToBounds( v, mins, maxs );
+        }
+        haveVertex = true; refs += count; offset += count * 4 * sizeof(short);
+    }
+    if( !haveVertex ) goto unsupported;
+    sg_mesh_cull.vertexRefs += refs;
+    // Retain geometry on planes despite renderer/driver float rounding.
+    for( axis = 0; axis < 3; axis++ ) { mins[axis] -= 0.125f; maxs[axis] += 0.125f; }
+    if( R_CullBox( mins, maxs )) { sg_mesh_cull.culled++; return true; }
+    // A large union box can intersect the view although its separated triangles
+    // cannot. Keep the complete original draw if any triangle might survive.
+    offset = mesh->triindex;
+    for( ;; )
+    {
+        qboolean fan;
+        unsigned int a, b, c;
+        cmd = (const short *)(base + offset);
+        count = *cmd++; offset += sizeof(short);
+        if( !count ) break;
+        fan = count < 0;
+        if( fan ) count = -count;
+        a = SGStudioVertexClipMask( g_studio.verts[cmd[0]] );
+        b = SGStudioVertexClipMask( g_studio.verts[cmd[4]] );
+        for( i = 2; i < count; i++ )
+        {
+            c = SGStudioVertexClipMask( g_studio.verts[cmd[i*4]] );
+            if( !(a & b & c) ) { sg_mesh_cull.passed++; return false; }
+            if( !fan ) a = b;
+            b = c;
+        }
+        offset += count * 4 * sizeof(short);
+    }
+    sg_mesh_cull.culled++; return true;
+unsupported:
+    sg_mesh_cull.unsupported++; return false;
+}
