+} sg_mesh_pvs;
+
+// Only validated classic BSP trees qualify. Any incomplete traversal retains
+// geometry; neither a truncated leaf list nor an invalid pointer proves hidden.
+static qboolean SGStudioPvsRange( const void *pointer, const void *base, size_t count, size_t stride )
+{
+    uintptr_t address=(uintptr_t)pointer, start=(uintptr_t)base;
+    if( !base || !stride || !count || count > SIZE_MAX / stride ) return false;
+    return address >= start && address - start < count * stride && !((address - start) % stride);
+}
+
+static qboolean SGStudioPvsBoxVisible( const vec3_t mins, const vec3_t maxs )
+{
+    const model_t *world=WORLDMODEL;
+    const mnode_t *stack[128];
+    size_t pending=1, visited=0, touched=0;
+    if( !mins || !maxs || !world || !world->nodes || !world->leafs || world->numnodes <= 0 ||
+        world->numleafs <= 0 || world->numleafs > MAX_MAP_LEAFS ||
+        world->numplanes <= 0 || !world->planes || (world->flags & MODEL_QBSP2) ) return true;
+    stack[0]=world->nodes;
+    while( pending )
+    {
+        const mnode_t *node=stack[--pending];
+        int sides;
+        if( ++visited > 8192 ) return true;
+        if( SGStudioPvsRange(node,world->nodes,world->numnodes,sizeof(*node)) )
+        {
+            if( node->contents != 0 || !SGStudioPvsRange(node->plane,world->planes,
+                world->numplanes,sizeof(*node->plane)) ) return true;
+            sides=BOX_ON_PLANE_SIDE(mins,maxs,node->plane);
+            if( sides < 1 || sides > 3 ) return true;
+            if( sides & 1 )
+            {
+                if( pending >= 128 ) return true;
+                stack[pending++]=node_child(node,0,world);
+            }
+            if( sides & 2 )
+            {
+                if( pending >= 128 ) return true;
+                stack[pending++]=node_child(node,1,world);
+            }
+        }
+        else if( SGStudioPvsRange(node,world->leafs,(size_t)world->numleafs+1,sizeof(*world->leafs)) )
+        {
+            const mleaf_t *leaf=(const mleaf_t *)node;
+            if( leaf->contents == CONTENTS_SOLID ) continue;
+            if( leaf->contents >= 0 || leaf->cluster < 0 || leaf->cluster >= world->numleafs ) return true;
+            touched++;
+            if( CHECKVISBIT(RI.visbytes,leaf->cluster) ) return true;
+        }
+        else return true;
+    }
+    return touched == 0;
+}
+
+static qboolean SGStudioMeshPvsOutside( const vec3_t mins, const vec3_t maxs )
+{
+    if( !r_studio_mesh_pvs.value ) return false;
+    sg_mesh_pvs.checked++;
+    // The caller has already validated static opaque world geometry and its
+    // transformed padded bounds. Unknown/disabled/custom PVS retains geometry.
+    if( !WORLDMODEL || !WORLDMODEL->visdata || !RI.viewleaf ||
+        RI.viewleaf->contents == CONTENTS_SOLID || RI.drawOrtho ||
+        tr.fCustomRendering || r_novis.value || r_lockpvs.value )
+    { sg_mesh_pvs.fallback++; return false; }
+    if( SGStudioPvsBoxVisible( mins, maxs ))
+    { sg_mesh_pvs.retained++; return false; }
+    sg_mesh_pvs.culled++; return true;
+}
