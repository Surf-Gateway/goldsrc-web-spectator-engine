+/* Realize deferred studio textures between frames under a wall-time budget so
+ * first sight of a new area does not convert and upload hundreds of textures
+ * inside one frame. Uses the same on-demand path; the upload binds with the raw
+ * API, so the active unit's binding cache is invalidated afterwards. */
+void GL_StudioPrerealize( void )
+{
+    static unsigned int cursor;
+    unsigned int visited, realized = 0;
+    double started, budget = r_studio_prerealize_ms.value;
+    if( budget <= 0.0 || !r_studio_texture_defer.value || !sg_studio_residency.pendingCount ) return;
+    if( budget > 8.0 ) budget = 8.0;
+    started = gEngfuncs.pfnTime();
+    for( visited = 0; visited < MAX_TEXTURES && sg_studio_residency.pendingCount; visited++ )
+    {
+        gl_texture_t *tex = &gl_textures[cursor];
+        cursor = ( cursor + 1 ) % MAX_TEXTURES;
+        if( tex->studio_state != SG_STUDIO_PENDING || !tex->studio_pending ) continue;
+        if( !GL_EnsureStudioTexture( tex )) break;
+        realized++;
+        if(( gEngfuncs.pfnTime() - started ) * 1000.0 >= budget ) break;
+    }
+    if( !realized ) return;
+    glState.currentTextures[glState.activeTMU] = 0;
+    sg_studio_residency.prerealizedTotal += realized;
+    GL_StudioResidencyReport();
+}
