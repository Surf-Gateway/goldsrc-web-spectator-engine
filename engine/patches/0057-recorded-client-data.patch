+/* Only numeric CS client buffers reach the pinned unchecked Demo_ReadBuffer. */
+#ifndef SG_DEMO_CLIENT_H
+#define SG_DEMO_CLIENT_H
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+static int SG_DemoFovValid( float fov ) { return isfinite(fov) && (fov == 0 || (fov >= 1 && fov <= 179)); }
+static int SG_DemoClientBuffer( const unsigned char *bytes, int size ) {
+ int32_t kind, flag; float value; int i;
+ if(!bytes || size < 4 || size > 36)return 0;
+ memcpy(&kind,bytes,4);
+ if(kind == 1) { if(size != 8)return -1; memcpy(&value,bytes+4,4); return SG_DemoFovValid(value) ? 1 : -1; }
+ if(kind != 0)return 0;
+ if(size < 8)return -1; memcpy(&flag,bytes+4,4);
+ if(flag == 0)return size == 8 ? 1 : -1;
+ if(flag != 1 || size != 36)return -1;
+ for(i=0;i<6;i++) { memcpy(&value,bytes+12+i*4,4); if(!isfinite(value) || fabsf(value) > (i<3 ? 360000.0f : 131072.0f))return -1; }
+ return 1;
+}
+#endif
