+// Expanded arrays have no consumers after the completed mesh draw. Keep the
+// original emitters and index builder; rebasing through zero avoids uploading
+// all earlier meshes again through WebGL client attribute pointers.
+static void SGStudioBeginMeshArrays( void )
+{
+    if( r_studio_mesh_compact.value ) g_studio.numverts = g_studio.numelems = 0;
+}
+static struct { double draws, compactDraws, submittedVertices, usedVertices, indices; } sg_mesh_arrays;
+void SGStudioMeshArraysReport( void )
+{
+#ifdef __EMSCRIPTEN__
+    EM_ASM({
+        const s = Module["sgStudioMeshArrays"] ??= {};
+        s.draws=$0;s.compactDraws=$1;s.submittedVertices=$2;s.usedVertices=$3;s.indices=$4;
+    },sg_mesh_arrays.draws,sg_mesh_arrays.compactDraws,sg_mesh_arrays.submittedVertices,
+        sg_mesh_arrays.usedVertices,sg_mesh_arrays.indices);
+#endif
+}
+
 static void R_StudioDrawArrays( uint startverts, uint startelems )
 {
+    sg_mesh_arrays.draws++;
+    sg_mesh_arrays.compactDraws += r_studio_mesh_compact.value != 0;
+    sg_mesh_arrays.submittedVertices += g_studio.numverts;
+    sg_mesh_arrays.usedVertices += g_studio.numverts - startverts;
+    sg_mesh_arrays.indices += g_studio.numelems - startelems;
