+// The GL2 shim maps GL_POLYGON to a triangle fan. Emit the identical triangles
+// across static surfaces sharing one lightmap atlas and unchanged pass state.
+// Keep every Begin/End below the shim's 8192-vertex limit, even within a polygon.
+#define STATIC_LIGHTMAP_BATCH_VERTS 3072
+static void R_DrawStaticLightmapBatch( msurface_t *surf )
+{
+	int vertices = 0;
+
+	for( ; surf != NULL; surf = surf->info->lightmapchain )
+	{
+		glpoly2_t *p;
+
+		for( p = surf->polys; p != NULL; p = p->chain )
+		{
+			int i;
+
+			for( i = 1; i + 1 < p->numverts; i++ )
+			{
+				const float *triangle[3] = { p->verts[0], p->verts[i], p->verts[i+1] };
+				int j;
+
+				if( !vertices ) pglBegin( GL_TRIANGLES );
+				for( j = 0; j < 3; j++ )
+				{
+					pglTexCoord2f( triangle[j][5], triangle[j][6] );
+					pglVertex3fv( triangle[j] );
+				}
+				vertices += 3;
+				if( vertices == STATIC_LIGHTMAP_BATCH_VERTS )
+				{
+					pglEnd();
+					vertices = 0;
+				}
+			}
+		}
+	}
+	if( vertices ) pglEnd();
+}
