+void V_ResetPlayerAvailability( void )
+{
+	sgPreviousPlayersLow = sgPreviousPlayersHigh = -1;
+}
+
+static void V_PublishPlayerAvailability( void )
+{
+	int low, high;
+	if( !cls.spectator ) return;
+	low = CL_GetPlayerDisplayMask( 1 );
+	high = CL_GetPlayerDisplayMask( 17 );
+	if( low == sgPreviousPlayersLow && high == sgPreviousPlayersHigh ) return;
+	sgPreviousPlayersLow = low;
+	sgPreviousPlayersHigh = high;
+	Cvar_SetValue( "_sg_web_players_low", low );
+	Cvar_SetValue( "_sg_web_players_high", high );
+#ifdef __EMSCRIPTEN__
+	EM_ASM({ if(Module["onSGPlayerAvailability"]) Module["onSGPlayerAvailability"]($0, $1); }, low, high);
+#endif
+}
