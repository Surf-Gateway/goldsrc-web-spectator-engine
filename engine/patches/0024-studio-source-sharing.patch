+    unsigned int key=(unsigned int)bytes^(unsigned int)raw;
+    unsigned int i;
+    for(i=0;i<8;i++)key=(key*16777619u)^buffer[i];
+    for(i=0;i<8;i++)key=(key*16777619u)^buffer[bytes-1-i];
+    return key;
