         s.lastRealizeMs=$8; s.maxRealizeMs=$9; s.totalRealizeMs=$10; s.logicalPendingBytes=$11; s.prerealizedTotal=$12;
+        s.textureCap=$13; s.capProjectedBytes=$14; s.fullProjectedBytes=$15;
     }, (double)sg_studio_residency.pendingBytes, (double)sg_studio_residency.peakPendingBytes,
        sg_studio_residency.pendingCount, sg_studio_residency.residentCount,
        sg_studio_residency.reservedTotal, sg_studio_residency.realizedTotal,
        sg_studio_residency.failures, SG_STUDIO_PENDING_BUDGET,
        sg_studio_residency.lastRealizeMs, sg_studio_residency.maxRealizeMs, sg_studio_residency.totalRealizeMs, (double)sg_studio_residency.logicalPendingBytes,
-       sg_studio_residency.prerealizedTotal);
+       sg_studio_residency.prerealizedTotal, sg_studio_residency.textureCap, sg_studio_residency.capProjectedBytes, sg_studio_residency.fullProjectedBytes);
 #endif
 }
 
@@ -443,6 +478,7 @@ static void SGGpuProfile( sg_gpu_upload_profile_t *profile )
     memset(profile,0,sizeof(*profile));
     profile->npot=GL_Support(GL_ARB_TEXTURE_NPOT_EXT);
     profile->maxTextureSize=glConfig.max_2d_texture_size;
+    { int cap=SGStudioTextureCap(); if(cap>0&&cap<profile->maxTextureSize) profile->maxTextureSize=cap; }
     profile->desktopBits=gpGlobals->desktopBitsPixel;
     profile->quake=ENGINE_GET_PARM(PARM_QUAKE_COMPATIBLE);
     profile->multisamples=glConfig.max_multisamples;
@@ -1370,6 +1406,13 @@ static void GL_SetTextureDimensions( gl_texture_t *tex, int width, int height, i
 		Assert( false );
 	}
 
+	// Budgeted MDL textures resample to the map's cap during realization.
+	if( tex->studio_state == SG_STUDIO_RESOLVING && tex->target == GL_TEXTURE_2D )
+	{
+		int cap = SGStudioTextureCap();
+		if( cap > 0 && cap < maxTextureSize ) maxTextureSize = cap;
+	}
+
 	// store original sizes
 	tex->srcWidth = width;
 	tex->srcHeight = height;
