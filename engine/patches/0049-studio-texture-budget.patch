diff --git a/ref/gl/gl_image.c b/ref/gl/gl_image.c
index 1f7e925..6a439e9 100644
--- a/ref/gl/gl_image.c
+++ b/ref/gl/gl_image.c
@@ -35,10 +35,44 @@ static struct
 {
     size_t pendingBytes, peakPendingBytes, logicalPendingBytes;
     unsigned int pendingCount, residentCount, reservedTotal, realizedTotal, failures, prerealizedTotal;
+    int textureCap, capKey; double capProjectedBytes, fullProjectedBytes;
     double lastRealizeMs, maxRealizeMs, totalRealizeMs;
 } sg_studio_residency;
 static qboolean GL_EnsureStudioTexture( gl_texture_t *tex );
 
+/* Largest power-of-two size cap (none, 512, 256, 128) under which every deferred
+ * or realized MDL texture of the current map fits the configured budget, as
+ * RGBA with mips. Recomputed when new textures are reserved. Light maps get no
+ * cap; only maps that would exceed the budget lose top detail. */
+static int SGStudioTextureCap( void )
+{
+    static const int caps[] = { 0, 512, 256, 128 };
+    double totals[4] = { 0 }, budget = r_studio_texture_budget_mb.value * 1024.0 * 1024.0;
+    int i, c;
+    if( budget <= 0.0 ) return 0;
+    if( sg_studio_residency.capKey == (int)sg_studio_residency.reservedTotal + 1 ) return sg_studio_residency.textureCap;
+    for( i = 1; i < MAX_TEXTURES; i++ )
+    {
+        const gl_texture_t *tex = &gl_textures[i];
+        int w, h;
+        if( tex->studio_state == SG_STUDIO_ORDINARY || tex->studio_state == SG_STUDIO_FAILED ) continue;
+        w = tex->studio_pending ? tex->studio_pending->width : tex->srcWidth;
+        h = tex->studio_pending ? tex->studio_pending->height : tex->srcHeight;
+        for( c = 0; c < 4; c++ )
+        {
+            int sw = w, sh = h;
+            while( caps[c] && ( sw > caps[c] || sh > caps[c] )) { sw = Q_max( 1, sw >> 1 ); sh = Q_max( 1, sh >> 1 ); }
+            totals[c] += (double)sw * sh * 4.0 * 4.0 / 3.0;
+        }
+    }
+    for( c = 0; c < 3 && totals[c] > budget; c++ );
+    sg_studio_residency.textureCap = caps[c];
+    sg_studio_residency.capProjectedBytes = totals[c];
+    sg_studio_residency.fullProjectedBytes = totals[0];
+    sg_studio_residency.capKey = (int)sg_studio_residency.reservedTotal + 1;
+    return caps[c];
+}
+
 void GL_StudioResidencyReport( void )
 {
 #ifdef __EMSCRIPTEN__
