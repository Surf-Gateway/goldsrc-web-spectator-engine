@@ -0,0 +1,35 @@
+/* Numeric GoldSrc demo_info_t decoding. Timestamp precedes 232-byte ref_params.
+ * Never restore the recorded pointers, viewport, callbacks or opaque structs. */
+#ifndef SG_DEMO_VIEW_H
+#define SG_DEMO_VIEW_H
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+typedef struct {
+ float origin[3], angles[3], velocity[3], simorg[3], height[3], punch[3];
+ float view_time, frame_time; int player, entity, ground, water, health;
+} sg_demo_view_t;
+static uint32_t SG_DemoU32( const unsigned char *p ) {
+ return (uint32_t)p[0] | ((uint32_t)p[1]<<8) | ((uint32_t)p[2]<<16) | ((uint32_t)p[3]<<24);
+}
+static float SG_DemoF32( const unsigned char *p ) { uint32_t u=SG_DemoU32(p);float f;memcpy(&f,&u,4);return f; }
+static int SG_DemoVector( const unsigned char *p, float *v, float limit ) {
+ int i;for(i=0;i<3;i++){v[i]=SG_DemoF32(p+i*4);if(!isfinite(v[i])||fabsf(v[i])>limit)return 0;}return 1;
+}
+/* 0: no recorded view; 1: valid view; -1: malformed numeric state. */
+static int SG_DemoDecodeView( const unsigned char *info, int length, sg_demo_view_t *out ) {
+ const unsigned char *p;sg_demo_view_t v;int clients;
+ if(length!=436)return -1;p=info+4;clients=(int32_t)SG_DemoU32(p+172);
+ if(clients==0)return 0;if(clients<1||clients>32)return -1;
+ memset(&v,0,sizeof(v));v.player=(int32_t)SG_DemoU32(p+180);v.entity=(int32_t)SG_DemoU32(p+176);
+ if(v.player<0||v.player>=clients||v.entity<1||v.entity>2048)return -1;v.player++;
+ if(!SG_DemoVector(p,v.origin,131072)||!SG_DemoVector(p+12,v.angles,360000)||
+    !SG_DemoVector(p+88,v.velocity,131072)||!SG_DemoVector(p+100,v.simorg,131072)||
+    !SG_DemoVector(p+112,v.height,1024)||!SG_DemoVector(p+160,v.punch,360000))return -1;
+ v.view_time=SG_DemoF32(p+64);v.frame_time=SG_DemoF32(p+60);
+ if(!isfinite(v.view_time)||fabsf(v.view_time)>1e9||!isfinite(v.frame_time)||v.frame_time<0||v.frame_time>1)return -1;
+ v.ground=(int32_t)SG_DemoU32(p+80);v.water=(int32_t)SG_DemoU32(p+84);v.health=(int32_t)SG_DemoU32(p+140);
+ if(v.ground<0||v.ground>1||v.water<0||v.water>3||v.health< -100000||v.health>100000)return -1;
+ *out=v;return 1;
+}
+#endif
