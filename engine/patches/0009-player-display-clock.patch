 // #define STUDIO_INTERPOLATION_FIX
 
+// Effective source time of the pose actually supplied to the HLTV camera.
+// Keep this outside SDK structs: no engine/client DLL ABI change.
+static struct
+{
+	qboolean valid;
+	int userid;
+	double time;
+} sgPlayerDisplay[MAX_CLIENTS];
+
+void CL_ClearPlayerDisplayTimes( void )
+{
+	memset( sgPlayerDisplay, 0, sizeof( sgPlayerDisplay ));
+}
+
+double CL_GetPlayerDisplayTime( int slot )
+{
+	if( !cls.spectator || slot < 1 || slot > cl.maxclients || slot > MAX_CLIENTS )
+		return -1.0;
+	if( !sgPlayerDisplay[slot - 1].valid ||
+		sgPlayerDisplay[slot - 1].userid != cl.players[slot - 1].userid ||
+		!cl.players[slot - 1].name[0] || cl.players[slot - 1].userid <= 0 )
+		return -1.0;
+	return sgPlayerDisplay[slot - 1].time;
+}
+
+static void CL_StorePlayerDisplayTime( cl_entity_t *ent, double time )
+{
+	int slot = ent->index;
+	if( !cls.spectator || slot < 1 || slot > cl.maxclients || slot > MAX_CLIENTS )
+		return;
+	sgPlayerDisplay[slot - 1].time = time;
+	sgPlayerDisplay[slot - 1].userid = cl.players[slot - 1].userid;
+	sgPlayerDisplay[slot - 1].valid = isfinite( time ) && time >= 0.0;
+}
+
+// Each SDK history entry's origin came from a world frame. Animation time
+// chooses the blend, but does not establish that frame's telemetry clock.
+typedef struct
+{
+	int userid;
+	double worldTime[HISTORY_MAX];
+	qboolean valid[HISTORY_MAX];
+} sg_player_history_t;
+static sg_player_history_t sgPlayerHistory[MAX_CLIENTS];
+
+void CL_ClearPlayerDisplayHistory( void )
+{
+	CL_ClearPlayerDisplayTimes();
+	memset( sgPlayerHistory, 0, sizeof( sgPlayerHistory ));
+}
+
+static sg_player_history_t *CL_PlayerSourceHistory( cl_entity_t *ent )
+{
+	int slot = ent->index;
+	sg_player_history_t *history;
+	if( !cls.spectator || !ent->player || slot < 1 || slot > cl.maxclients || slot > MAX_CLIENTS )
+		return NULL;
+	history = &sgPlayerHistory[slot - 1];
+	if( history->userid != cl.players[slot - 1].userid )
+	{
+		memset( history, 0, sizeof( *history ));
+		history->userid = cl.players[slot - 1].userid;
+	}
+	return history->userid > 0 ? history : NULL;
+}
+
+static void CL_StorePlayerHistoryTime( cl_entity_t *ent )
+{
+	sg_player_history_t *history = CL_PlayerSourceHistory( ent );
+	if( !history ) return;
+	history->worldTime[ent->current_position] = ent->curstate.msg_time;
+	history->valid[ent->current_position] = isfinite( ent->curstate.msg_time ) && ent->curstate.msg_time >= 0.0;
+}
+
+static void CL_ResetPlayerSourceHistory( cl_entity_t *ent )
+{
+	sg_player_history_t *history = CL_PlayerSourceHistory( ent );
+	double time;
+	qboolean valid;
+	if( !history ) return;
+	time = history->worldTime[ent->current_position];
+	valid = history->valid[ent->current_position];
+	memset( history->worldTime, 0, sizeof( history->worldTime ));
+	memset( history->valid, 0, sizeof( history->valid ));
+	history->worldTime[0] = history->worldTime[1] = time;
+	history->valid[0] = history->valid[1] = valid;
+}
+
+static double CL_PlayerHistoryTime( cl_entity_t *ent, position_history_t *ph0, position_history_t *ph1, double frac )
+{
+	sg_player_history_t *history = CL_PlayerSourceHistory( ent );
+	int i0 = ph0 - ent->ph;
+	int i1 = ph1 - ent->ph;
+	if( !history ) return -1.0;
+	if( frac == 0.0 ) return history->valid[i1] ? history->worldTime[i1] : -1.0;
+	if( frac == 1.0 ) return history->valid[i0] ? history->worldTime[i0] : -1.0;
+	if( !history->valid[i0] || !history->valid[i1] ) return -1.0;
+	return history->worldTime[i1] + frac * ( history->worldTime[i0] - history->worldTime[i1] );
+}
