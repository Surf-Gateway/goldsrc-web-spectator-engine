 /*
@@ -2420,6 +2426,18 @@ void CL_ParseUserMessage( sizebuf_t *msg, int svc_num, connprotocol_t proto )
 
 	// parse user message into buffer
 	MSG_ReadBytes( msg, pbuf, iSize );
+#ifdef __EMSCRIPTEN__
+	// Consume opaque SGTV1 bytes before the unregistered client-DLL stub.
+	// Copy synchronously: pbuf is stack memory, not retained WASM memory.
+	if( proto == PROTO_GOLDSRC || proto == PROTO_LEGACY )
+	{
+		if( !MSG_CheckOverflow( msg ) && !Q_strcmp( clgame.msg[i].name, "SGTV1" ))
