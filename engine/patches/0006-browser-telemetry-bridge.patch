 */
 
 #include "common.h"
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
 #include "client.h"
 #include "const.h"
 #include "entity_types.h"
@@ -404,6 +407,18 @@ void V_RenderView( void )
 	// draw debug triangles on a server
 	SV_DrawDebugTriangles ();
 	ref.dllFuncs.GL_BackendEndFrame ();
+#ifdef __EMSCRIPTEN__
+	// The client DLL publishes its actual first-person target after CalcRefdef.
+	// cl.time is also rp.time: never substitute packet arrival or wall time.
+	{
+		int slot = (int)Cvar_VariableValue( "_sg_web_target" );
+		int userid = 0;
+		if( slot >= 1 && slot <= cl.maxclients && slot <= MAX_CLIENTS && cl.players[slot - 1].name[0] )
+			userid = cl.players[slot - 1].userid;
+		else slot = 0;
+		EM_ASM({ if(Module["onSGFrame"]) Module["onSGFrame"]($0, $1, $2); }, rp.time, slot, userid);
+	}
+#endif
 }
 
