+			EM_ASM({ if(Module["onSGTelemetry"]) Module["onSGTelemetry"](HEAPU8.slice($0, $0 + $1)); }, pbuf, iSize);
+			return;
+		}
+	}
+#endif
 
 	if( cl_trace_messages.value )
 	{
