+/* Detached source-proof primitive. The actual source registry/flags/layouts
+ * must be supplied by the pinned native adapter. No GPU object or source ref is
+ * acquired here. Capture before decode; never keep this stack key's palette
+ * past the separate bounded admission layer's lifetime. */
+typedef struct {
+    int npot,maxTextureSize,desktopBits,quake,multisamples;
+    float roundDown,nearest,anisotropy,lodBias;
+}sg_gpu_upload_profile_t;
+typedef struct {
+    unsigned int blob,serial,width,height,depth,type,imageFlags,encode,numMips,textureFlags;
+    size_t rawBytes,codecBytes;
+    rgba_t fog;
+    sg_gpu_upload_profile_t profile;
+    byte palette[1024];
+}sg_gpu_source_key_t;
+static unsigned int sg_gpu_source_serials[SG_STUDIO_BLOB_RECORDS],sg_gpu_source_sequence;
+
+static void SGGpuSourceCreated( unsigned int blob )
+{
+    if(!blob||blob>SG_STUDIO_BLOB_RECORDS)
+    {gEngfuncs.Host_Error("Invalid studio GPU source slot\n");return;}
+    /* Overflow disables new admissions; old live serials remain distinguishable. */
+    sg_gpu_source_serials[blob-1]=sg_gpu_source_sequence==UINT32_MAX?0:++sg_gpu_source_sequence;
+}
+static void SGGpuSourceRetired( unsigned int blob )
+{
+    if(!blob||blob>SG_STUDIO_BLOB_RECORDS)
+    {gEngfuncs.Host_Error("Invalid studio GPU source retirement\n");return;}
+    sg_gpu_source_serials[blob-1]=0;
+    /* The following admission layer must also unlink/free this blob's keys. */
+}
+static qboolean SGGpuSourceCurrent( const sg_gpu_source_key_t *key )
+{
+    if(!key->blob||key->blob>SG_STUDIO_BLOB_RECORDS||!key->serial)return false;
+    return sg_gpu_source_serials[key->blob-1]==key->serial&&
+        sg_studio_blobs[key->blob-1].refs&&sg_studio_blobs[key->blob-1].buffer&&
+        sg_studio_blobs[key->blob-1].rawBytes==key->rawBytes&&sg_studio_blobs[key->blob-1].bytes==key->codecBytes;
+}
+static qboolean SGGpuSourceCapture( const gl_texture_t *tex, const sg_gpu_upload_profile_t *profile, sg_gpu_source_key_t *key )
+{
+    const rgbdata_t *pic=tex->studio_pending;
+    unsigned int blob=tex->studio_shared_blob;
+    if(!pic||!pic->buffer||!pic->palette||!blob||blob>SG_STUDIO_BLOB_RECORDS||!sg_gpu_source_serials[blob-1]||
+       !sg_studio_blobs[blob-1].refs||sg_studio_blobs[blob-1].buffer!=pic->buffer||
+       sg_studio_blobs[blob-1].rawBytes!=pic->size||sg_studio_blobs[blob-1].bytes!=tex->studio_codec_bytes||
+       pic->type!=PF_INDEXED_32||pic->depth!=1||pic->numMips>1||!pic->width||!pic->height||
+       pic->size!=(size_t)pic->width*pic->height||pic->size>4u*1024u*1024u||
+       tex->studio_codec_bytes<16||tex->studio_codec_bytes>=pic->size||tex->original||tex->target!=GL_TEXTURE_2D||
+       (tex->studio_state!=SG_STUDIO_PENDING&&tex->studio_state!=SG_STUDIO_RESOLVING)||
+       (pic->flags&~(IMAGE_HAS_COLOR|IMAGE_HAS_ALPHA|IMAGE_ONEBIT_ALPHA))||
+       (tex->flags&~(TF_NOMIPMAP|TF_HAS_ALPHA))||
+       ((tex->flags&TF_HAS_ALPHA)!=0)!=((pic->flags&IMAGE_HAS_ALPHA)!=0))return false;
+    memset(key,0,sizeof(*key));key->blob=blob;key->serial=sg_gpu_source_serials[blob-1];
+    key->width=pic->width;key->height=pic->height;key->depth=pic->depth;key->type=pic->type;
+    key->imageFlags=pic->flags;key->encode=pic->encode;key->numMips=pic->numMips;key->textureFlags=tex->flags;
+    key->rawBytes=pic->size;key->codecBytes=tex->studio_codec_bytes;
+    memcpy(key->fog,pic->fogParams,sizeof(key->fog));memcpy(key->palette,pic->palette,sizeof(key->palette));
+    /* Copy fields explicitly; padding in a caller's profile is not evidence. */
+    key->profile.npot=profile->npot;key->profile.maxTextureSize=profile->maxTextureSize;
+    key->profile.desktopBits=profile->desktopBits;key->profile.quake=profile->quake;key->profile.multisamples=profile->multisamples;
+    memcpy(&key->profile.roundDown,&profile->roundDown,sizeof(profile->roundDown));
+    memcpy(&key->profile.nearest,&profile->nearest,sizeof(profile->nearest));
+    memcpy(&key->profile.anisotropy,&profile->anisotropy,sizeof(profile->anisotropy));
+    memcpy(&key->profile.lodBias,&profile->lodBias,sizeof(profile->lodBias));
+    return true;
+}
+static qboolean SGGpuSourceEqual( const sg_gpu_source_key_t *a, const sg_gpu_source_key_t *b )
+{
+    /* Both zero-initialized keys require current source generations. The exact
+     * source registry already proved shared pixels; palette/options remain exact.
+     * No hash/name, retired pointer or equal metadata alone proves source bytes. */
+    return SGGpuSourceCurrent(a)&&SGGpuSourceCurrent(b)&&!memcmp(a,b,sizeof(*a));
+}
+
+/* Detached admission registry. Exactly one MiB of fixed palette storage,
+ * bounded scalar metadata, no heap allocation or borrowed texture pointers.
+ * Caller integration must retire these records before source/group recycling. */
+#define SG_GPU_PROOF_RECORDS 1024u
+typedef struct {
+    unsigned int width,height,depth,srcWidth,srcHeight,target,format,flags,encode,numMips;
+    size_t bytes;
+    rgba_t fog;
+}sg_gpu_uploaded_meta_t;
+typedef struct {
+    sg_gpu_source_key_t key;
+    sg_gpu_uploaded_meta_t uploaded;
+    sg_gpu_handle_t group;
+    unsigned int next,nextFree;
+}sg_gpu_proof_t;
+static sg_gpu_proof_t sg_gpu_proofs[SG_GPU_PROOF_RECORDS];
+static unsigned int sg_gpu_proof_heads[SG_STUDIO_BLOB_RECORDS],sg_gpu_proof_by_group[MAX_TEXTURES];
+static struct {unsigned int ready,freeHead,live,peak,refusals;}sg_gpu_proof;
+
+static void SGGpuProofInit( void )
+{
+    unsigned int i;
+    if(sg_gpu_proof.ready)return;
+    for(i=0;i<SG_GPU_PROOF_RECORDS;i++)sg_gpu_proofs[i].nextFree=i+2;
+    sg_gpu_proofs[SG_GPU_PROOF_RECORDS-1].nextFree=0;sg_gpu_proof.freeHead=1;sg_gpu_proof.ready=1;
+}
+static qboolean SGGpuProofRemove( unsigned int id )
+{
+    sg_gpu_proof_t *record;
+    unsigned int *link,visited=0;
+    if(!id||id>SG_GPU_PROOF_RECORDS)return false;
+    record=&sg_gpu_proofs[id-1];
+    if(!record->group.id||record->group.id>MAX_TEXTURES||!record->key.blob||record->key.blob>SG_STUDIO_BLOB_RECORDS||
+       sg_gpu_proof_by_group[record->group.id-1]!=id)
+    {gEngfuncs.Host_Error("Invalid studio GPU proof ownership\n");return false;}
+    link=&sg_gpu_proof_heads[record->key.blob-1];
+    while(*link&&*link!=id&&visited++<16)
+    {
+        if(*link>SG_GPU_PROOF_RECORDS){gEngfuncs.Host_Error("Invalid studio GPU proof link\n");return false;}
+        link=&sg_gpu_proofs[*link-1].next;
+    }
+    if(*link!=id){gEngfuncs.Host_Error("Missing studio GPU proof\n");return false;}
+    *link=record->next;sg_gpu_proof_by_group[record->group.id-1]=0;sg_gpu_proof.live--;
+    memset(record,0,sizeof(*record));record->nextFree=sg_gpu_proof.freeHead;sg_gpu_proof.freeHead=id;
+    return true;
+}
+static qboolean SGGpuProofDropGroup( sg_gpu_handle_t group )
+{
+    unsigned int id;
+    if(!group.id||group.id>MAX_TEXTURES)return false;
+    id=sg_gpu_proof_by_group[group.id-1];
+    if(!id)return true;
+    if(id>SG_GPU_PROOF_RECORDS||sg_gpu_proofs[id-1].group.generation!=group.generation)return false;
+    return SGGpuProofRemove(id);
+}
+static void SGGpuProofRetireSource( unsigned int blob )
+{
+    unsigned int id,visited=0;
+    SGGpuSourceRetired(blob);
+    if(!blob||blob>SG_STUDIO_BLOB_RECORDS)return;
+    while((id=sg_gpu_proof_heads[blob-1])!=0)
+    {
+        if(++visited>16||!SGGpuProofRemove(id))
+        {gEngfuncs.Host_Error("Invalid studio GPU source proof retirement\n");return;}
+    }
+}
+static qboolean SGGpuProofPublish( const sg_gpu_source_key_t *key, sg_gpu_handle_t handle, const gl_texture_t *tex )
+{
+    sg_gpu_group_t *group=SGGpuLookup(handle);
+    sg_gpu_proof_t *record;
+    unsigned int id,entry,visited=0;
+    if(!SGGpuSourceCurrent(key)||!group||group->object!=tex->texnum||group->bytes!=tex->size||
+       tex->target!=GL_TEXTURE_2D||!tex->width||!tex->height||tex->depth!=1||!tex->numMips||
+       tex->srcWidth!=key->width||tex->srcHeight!=key->height||sg_gpu_proof_by_group[handle.id-1])
+    {sg_gpu_proof.refusals++;return false;}
+    SGGpuProofInit();
+    for(entry=sg_gpu_proof_heads[key->blob-1];entry;entry=sg_gpu_proofs[entry-1].next)
+    {
+        if(entry>SG_GPU_PROOF_RECORDS||++visited>=16){sg_gpu_proof.refusals++;return false;}
+    }
+    if(!sg_gpu_proof.freeHead){sg_gpu_proof.refusals++;return false;}
+    id=sg_gpu_proof.freeHead;record=&sg_gpu_proofs[id-1];sg_gpu_proof.freeHead=record->nextFree;
+    memset(record,0,sizeof(*record));memcpy(&record->key,key,sizeof(*key));record->group=handle;
+    record->uploaded.width=tex->width;record->uploaded.height=tex->height;record->uploaded.depth=tex->depth;
+    record->uploaded.srcWidth=tex->srcWidth;record->uploaded.srcHeight=tex->srcHeight;
+    record->uploaded.target=tex->target;record->uploaded.format=tex->format;record->uploaded.flags=tex->flags;
+    record->uploaded.encode=tex->encode;record->uploaded.numMips=tex->numMips;record->uploaded.bytes=tex->size;
+    memcpy(record->uploaded.fog,tex->fogParams,sizeof(record->uploaded.fog));
+    record->next=sg_gpu_proof_heads[key->blob-1];sg_gpu_proof_heads[key->blob-1]=id;
+    sg_gpu_proof_by_group[handle.id-1]=id;sg_gpu_proof.live++;
+    if(sg_gpu_proof.live>sg_gpu_proof.peak)sg_gpu_proof.peak=sg_gpu_proof.live;
+    return true;
+}
+static sg_gpu_handle_t SGGpuProofFind( const sg_gpu_source_key_t *key, sg_gpu_uploaded_meta_t *uploaded )
+{
+    unsigned int entry,visited=0;
+    sg_gpu_handle_t empty={0,0};
+    if(!SGGpuSourceCurrent(key))return empty;
+    for(entry=sg_gpu_proof_heads[key->blob-1];entry;entry=sg_gpu_proofs[entry-1].next)
+    {
+        sg_gpu_proof_t *record;
+        sg_gpu_group_t *group;
+        if(entry>SG_GPU_PROOF_RECORDS||++visited>16){sg_gpu_proof.refusals++;return empty;}
+        record=&sg_gpu_proofs[entry-1];group=SGGpuLookup(record->group);
+        if(!group||group->bytes!=record->uploaded.bytes||!SGGpuSourceEqual(key,&record->key))continue;
+        memcpy(uploaded,&record->uploaded,sizeof(*uploaded));return record->group;
+    }
+    return empty;
+}
+static void SGGpuProofResetEmpty( void )
+{
+    unsigned int i;
+    Assert(!sg_gpu_proof.live);
+    for(i=0;i<SG_STUDIO_BLOB_RECORDS;i++)Assert(!sg_gpu_proof_heads[i]);
+    for(i=0;i<MAX_TEXTURES;i++)Assert(!sg_gpu_proof_by_group[i]);
+    for(i=0;i<SG_GPU_PROOF_RECORDS;i++)Assert(!sg_gpu_proofs[i].group.id);
+    sg_gpu_proof.ready=0;sg_gpu_proof.freeHead=0;
+}
+
+/* Private native candidate adapter. Admission only at deferred studio resolve;
+ * all grouped mutations pass a central full-replacement guard. */
+static qboolean sg_gpu_checking,sg_gpu_upload_error;
+static struct {unsigned int hits,misses,uploadErrors,allocationRefusals;}sg_gpu_native;
+static void SGGpuProfile( sg_gpu_upload_profile_t *profile )
+{
+    memset(profile,0,sizeof(*profile));
+    profile->npot=GL_Support(GL_ARB_TEXTURE_NPOT_EXT);
+    profile->maxTextureSize=glConfig.max_2d_texture_size;
+    profile->desktopBits=gpGlobals->desktopBitsPixel;
+    profile->quake=ENGINE_GET_PARM(PARM_QUAKE_COMPATIBLE);
+    profile->multisamples=glConfig.max_multisamples;
+    profile->roundDown=gl_round_down.value;profile->nearest=gl_texture_nearest.value;
+    profile->anisotropy=gl_texture_anisotropy.value;profile->lodBias=gl_texture_lodbias.value;
+}
+static qboolean SGGpuTryJoin( gl_texture_t *tex, const sg_gpu_source_key_t *key )
+{
+    gl_texture_t saved;
+    sg_gpu_uploaded_meta_t meta;
+    sg_gpu_handle_t handle=SGGpuProofFind(key,&meta);
+    if(!handle.id){sg_gpu_native.misses++;return false;}
+    memcpy(&saved,tex,sizeof(saved));
+    tex->width=meta.width;tex->height=meta.height;tex->depth=meta.depth;
+    tex->srcWidth=meta.srcWidth;tex->srcHeight=meta.srcHeight;tex->target=meta.target;
+    tex->format=meta.format;tex->flags=meta.flags;tex->encode=meta.encode;tex->numMips=meta.numMips;tex->size=meta.bytes;
+    memcpy(tex->fogParams,meta.fog,sizeof(meta.fog));
+    if(!SGGpuAdopt(tex,handle)){memcpy(tex,&saved,sizeof(saved));return false;}
+    /* Equivalent to original upload's binding, without pretending to upload. */
+    glState.currentTextures[glState.activeTMU]=tex->texnum;
+    glState.currentTexturesIndex[glState.activeTMU]=tex-gl_textures;
+    pglBindTexture(tex->target,tex->texnum);sg_gpu_native.hits++;
+    return true;
+}
+static qboolean SGGpuReleaseWithProof( gl_texture_t *tex )
+{
+    sg_gpu_handle_t handle=sg_gpu_slots[SGGpuSlot(tex)];
+    sg_gpu_group_t *group=SGGpuLookup(handle);
+    if(group&&group->refs==1&&!SGGpuProofDropGroup(handle))return false;
+    return SGGpuRelease(tex);
+}
+static qboolean SGGpuPrepareUpload( gl_texture_t *tex )
+{
+    sg_gpu_handle_t handle=sg_gpu_slots[SGGpuSlot(tex)];
+    sg_gpu_group_t *group=SGGpuLookup(handle);
+    GLuint fresh=0;
+    unsigned int tries=0;
+    if(!handle.id)return true;
+    if(!glw_state.initialized||!group||group->object!=tex->texnum)return false;
+    if(group->refs>1)
+    {
+        /* Pending GL errors cannot prove a successful fresh allocation. */
+        if(pglGetError()!=GL_NO_ERROR){sg_gpu_native.allocationRefusals++;return false;}
+        do
+        {
+            pglGenTextures(1,&fresh);
+            if(pglGetError()!=GL_NO_ERROR||!fresh||SGGpuObjectKnown(fresh))
+            {
+                if(fresh&&!SGGpuObjectKnown(fresh))pglDeleteTextures(1,&fresh);
+                sg_gpu_native.allocationRefusals++;return false;
+            }
+            if(fresh<SKYBOX_BASE_NUM||fresh>SKYBOX_BASE_NUM+SKYBOX_MAX_SIDES)break;
+            pglDeleteTextures(1,&fresh);fresh=0;
+        }while(++tries<16);
+        if(!fresh){sg_gpu_native.allocationRefusals++;return false;}
+    }
+    if(!SGGpuProofDropGroup(handle)||!SGGpuDetach(tex,fresh))
+    {
+        if(fresh)pglDeleteTextures(1,&fresh);
+        return false;
+    }
