+/* Detached ownership primitive, not an admission proof or production patch.
+ * Register/adopt only after independently verified source/upload metadata.
+ * Object allocation, full replacement and source-key retirement remain callers'
+ * responsibilities. No source/palette/RGBA pointers are retained here. */
+typedef struct {unsigned int id,generation;}sg_gpu_handle_t;
+typedef struct {
+    GLuint object;
+    unsigned int generation,refs,next,nextFree;
+    size_t bytes;
+}sg_gpu_group_t;
+static sg_gpu_group_t sg_gpu_groups[MAX_TEXTURES];
+static sg_gpu_handle_t sg_gpu_slots[MAX_TEXTURES];
+static unsigned int sg_gpu_buckets[MAX_TEXTURES];
+static struct {
+    unsigned int ready,freeHead,generation,groups,owners,refusals;
+    size_t uniqueBytes;
+}sg_gpu;
+
+static unsigned int SGGpuSlot( const gl_texture_t *tex )
+{
+    uintptr_t address=(uintptr_t)tex,base=(uintptr_t)gl_textures;
+    Assert(address>=base&&address<base+sizeof(gl_textures)&&!((address-base)%sizeof(*tex)));
+    return (unsigned int)((address-base)/sizeof(*tex));
+}
+static sg_gpu_group_t *SGGpuLookup( sg_gpu_handle_t handle )
+{
+    sg_gpu_group_t *group;
+    if(!handle.id||handle.id>MAX_TEXTURES)return NULL;
+    group=&sg_gpu_groups[handle.id-1];
+    if(!group->refs||group->generation!=handle.generation)return NULL;
+    return group;
+}
+static void SGGpuInit( void )
+{
+    unsigned int i;
+    if(sg_gpu.ready)return;
+    for(i=0;i<MAX_TEXTURES;i++)sg_gpu_groups[i].nextFree=i+2;
+    sg_gpu_groups[MAX_TEXTURES-1].nextFree=0;
+    sg_gpu.freeHead=1;sg_gpu.ready=1;
+}
+static qboolean SGGpuObjectKnown( GLuint object )
+{
+    unsigned int entry,visited=0;
+    for(entry=sg_gpu_buckets[object%MAX_TEXTURES];entry;entry=sg_gpu_groups[entry-1].next)
+    {
+        if(++visited>16||entry>MAX_TEXTURES)return true;
+        if(sg_gpu_groups[entry-1].object==object)return true;
+    }
+    return false;
+}
+static sg_gpu_handle_t SGGpuRegister( gl_texture_t *tex )
+{
+    unsigned int slot=SGGpuSlot(tex),entry,bucket,visited=0,walk;
+    sg_gpu_group_t *group;
+    sg_gpu_handle_t empty={0,0};
+    if(!slot||!glw_state.initialized||!tex->texnum||!tex->size||tex->target!=GL_TEXTURE_2D||
+       sg_gpu_slots[slot].id||sg_gpu.generation==UINT32_MAX||SGGpuObjectKnown(tex->texnum))
+    {sg_gpu.refusals++;return empty;}
+    SGGpuInit();bucket=tex->texnum%MAX_TEXTURES;
+    for(walk=sg_gpu_buckets[bucket];walk;walk=sg_gpu_groups[walk-1].next)
+        if(++visited>=16){sg_gpu.refusals++;return empty;}
+    if(!sg_gpu.freeHead||tex->size>SIZE_MAX-sg_gpu.uniqueBytes){sg_gpu.refusals++;return empty;}
+    entry=sg_gpu.freeHead;group=&sg_gpu_groups[entry-1];sg_gpu.freeHead=group->nextFree;
+    memset(group,0,sizeof(*group));group->object=tex->texnum;group->refs=1;group->bytes=tex->size;
+    group->generation=++sg_gpu.generation;group->next=sg_gpu_buckets[bucket];sg_gpu_buckets[bucket]=entry;
+    sg_gpu_slots[slot]=(sg_gpu_handle_t){entry,group->generation};
+    sg_gpu.groups++;sg_gpu.owners++;sg_gpu.uniqueBytes+=group->bytes;
+    return sg_gpu_slots[slot];
+}
+static void SGGpuInvalidateObject( GLuint object )
+{
+    unsigned int i;
+    GLint active=glState.activeTMU;
+    for(i=0;i<MAX_TEXTURE_UNITS;i++)
+    {
+        if(glState.currentTextures[i]!=object)continue;
+        if(glState.currentTextureTargets[i]!=GL_NONE)
+        {GL_SelectTexture(i);pglDisable(glState.currentTextureTargets[i]);}
+        glState.currentTextureTargets[i]=GL_NONE;glState.currentTextures[i]=-1;glState.currentTexturesIndex[i]=0;
+    }
+    if(glState.activeTMU!=active)GL_SelectTexture(active);
+}
+static qboolean SGGpuAdopt( gl_texture_t *tex, sg_gpu_handle_t handle )
+{
+    unsigned int slot=SGGpuSlot(tex);
+    sg_gpu_group_t *group=SGGpuLookup(handle);
+    GLuint reserved=tex->texnum;
+    if(!slot||!glw_state.initialized||!group||sg_gpu_slots[slot].id||!reserved||reserved==group->object||
+       tex->target!=GL_TEXTURE_2D||tex->size!=group->bytes||group->refs>=MAX_TEXTURES||SGGpuObjectKnown(reserved))
+    {sg_gpu.refusals++;return false;}
+    /* The caller has already copied proven identical uploaded scalar metadata. */
+    SGGpuInvalidateObject(reserved);pglDeleteTextures(1,&reserved);
+    tex->texnum=group->object;group->refs++;sg_gpu.owners++;sg_gpu_slots[slot]=handle;
+    return true;
+}
+/* Called from actual deletion instead of unconditional physical deletion.
+ * An ordinary owner or the final group owner deletes; other members release
+ * their logical ref only. Broken registered ownership must never fall through. */
+static qboolean SGGpuRelease( gl_texture_t *tex )
+{
+    unsigned int slot=SGGpuSlot(tex),*link,visited=0;
+    sg_gpu_handle_t handle=sg_gpu_slots[slot];
+    sg_gpu_group_t *group;
+    if(!handle.id)return true;
+    group=SGGpuLookup(handle);
+    if(!group||group->object!=tex->texnum)
+    {gEngfuncs.Host_Error("Invalid studio GPU ownership\n");return false;}
+    link=&sg_gpu_buckets[group->object%MAX_TEXTURES];
+    if(group->refs==1)
+    {
+        while(*link&&*link!=handle.id&&visited++<16)
+        {
+            if(*link>MAX_TEXTURES){gEngfuncs.Host_Error("Invalid studio GPU registry link\n");return false;}
+            link=&sg_gpu_groups[*link-1].next;
+        }
+        if(*link!=handle.id){gEngfuncs.Host_Error("Invalid studio GPU registry\n");return false;}
+    }
+    memset(&sg_gpu_slots[slot],0,sizeof(sg_gpu_slots[slot]));sg_gpu.owners--;
+    if(--group->refs)return false;
+    *link=group->next;sg_gpu.groups--;sg_gpu.uniqueBytes-=group->bytes;
+    memset(group,0,sizeof(*group));group->nextFree=sg_gpu.freeHead;sg_gpu.freeHead=handle.id;
+    return true;
+}
+/* Full-image replacement primitive. Caller supplies a freshly generated name
+ * when >1 refs remain. Zero refuses without changing refs/name/cache/flags.
+ * This does not perform GPU allocation, upload or old-content reconstruction. */
+static qboolean SGGpuDetach( gl_texture_t *tex, GLuint replacement )
+{
+    sg_gpu_handle_t handle=sg_gpu_slots[SGGpuSlot(tex)];
+    sg_gpu_group_t *group;
+    GLuint original=tex->texnum;
+    if(!handle.id)return true;
+    group=SGGpuLookup(handle);
+    if(!group||group->object!=original)
+    {gEngfuncs.Host_Error("Invalid studio GPU detach\n");return false;}
+    if(group->refs>1&&(!replacement||replacement==original||SGGpuObjectKnown(replacement)))
+    {sg_gpu.refusals++;return false;}
+    if(group->refs>1)
+    {
+        SGGpuRelease(tex);SGGpuInvalidateObject(original);tex->texnum=replacement;
+    }
+    else if(!SGGpuRelease(tex))return false;
+    /* A formerly grouped full replacement always receives complete storage. */
+    ClearBits(tex->flags,TF_IMG_UPLOADED);
+    return true;
+}
+static void SGGpuResetEmpty( void )
+{
+    unsigned int i;
+    Assert(!sg_gpu.groups&&!sg_gpu.owners&&!sg_gpu.uniqueBytes);
+    for(i=0;i<MAX_TEXTURES;i++)Assert(!sg_gpu_slots[i].id&&!sg_gpu_groups[i].refs&&!sg_gpu_buckets[i]);
+    /* Generation stays monotonic across map/context reuse. */
+    sg_gpu.ready=0;sg_gpu.freeHead=0;
+}
