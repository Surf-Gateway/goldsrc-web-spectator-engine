+/* One mesh's original scalar/float words; every original destination is written. */
+static struct {
+    uint64_t consideredMeshes, eligibleMeshes, eligibleNormals, originalNormals;
+} sgStudioConstantStats;
+static qboolean SGStudioConstantLighting(int count,int index,vec3_t *normal,
+    byte *bone,float *lv,vec3_t color)
+{
+    sgStudioConstantStats.consideredMeshes++;
+    if(count>0 && r_studio_constant_light.value &&
+        RI.currententity->curstate.rendermode!=kRenderTransAdd &&
+        !(g_nFaceFlags&STUDIO_NF_CHROME) &&
+        ((g_nFaceFlags&(STUDIO_NF_FULLBRIGHT|STUDIO_NF_FLATSHADE)) ||
+            g_studio.shadelight==0.0f))
+    {
+        if(FBitSet(m_pStudioHeader->flags,STUDIO_HAS_BONEWEIGHTS))
+            R_StudioLighting(lv,-1,g_nFaceFlags,g_studio.norms[index]);
+        else R_StudioLighting(lv,*bone,g_nFaceFlags,(float *)normal);
+        VectorScale(g_studio.lightcolor,*lv,color);
+        sgStudioConstantStats.eligibleMeshes++;
+        sgStudioConstantStats.eligibleNormals+=count;
+        return true;
+    }
+    if(count>0)sgStudioConstantStats.originalNormals+=count;
+    return false;
+}
+
+
+void SGStudioConstantLightingReport(void)
+{
+#ifdef __EMSCRIPTEN__
+    EM_ASM({const s=Module["sgStudioConstantLighting"]||(Module["sgStudioConstantLighting"]={});
+      s.schemaVersion=1;s.enabled=Boolean($0);s.consideredMeshes=$1;s.eligibleMeshes=$2;
+      s.eligibleNormals=$3;s.originalNormals=$4;s.scalarCalculationsSaved=$5;
+      s.numericMetadataBytes=$6;s.drawLocalBytes=$7;},
+      r_studio_constant_light.value,(double)sgStudioConstantStats.consideredMeshes,
+      (double)sgStudioConstantStats.eligibleMeshes,(double)sgStudioConstantStats.eligibleNormals,
+      (double)sgStudioConstantStats.originalNormals,
+      (double)(sgStudioConstantStats.eligibleNormals-sgStudioConstantStats.eligibleMeshes),
+      sizeof(sgStudioConstantStats),sizeof(vec3_t));
+#endif
+}
