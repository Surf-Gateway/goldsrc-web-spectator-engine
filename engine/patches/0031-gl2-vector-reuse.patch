+static void SGGL2VectorUniform(gl2wrap_prog_t *prog,int kind,const GLfloat *value)
+{
+    uint32_t words[4],mask=1u<<kind;
+    const int enabled=r_gl2_vector_reuse.value!=0;
+    sgVectorReuse.requested[kind]++;
+    if(enabled){
+        memcpy(words,value,sizeof(words));
+        if((prog->sgVectorValid&mask)&&!memcmp(prog->sgVectorWords[kind],words,sizeof(words))){
+            sgVectorReuse.skipped[kind]++;return;
+        }
+    }else prog->sgVectorValid&=~mask;
+    pglUniform4fvARB(kind?prog->ufog:prog->ucolor,1,value);
+    sgVectorReuse.submitted[kind]++;
+    if(enabled){memcpy(prog->sgVectorWords[kind],words,sizeof(words));prog->sgVectorValid|=mask;}
+}
