+/* GoldSrc file-only numeric event and relative sound-name guards. */
+#ifndef SG_DEMO_EFFECTS_H
+#define SG_DEMO_EFFECTS_H
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+static int32_t SG_DEInt(const unsigned char *p){int32_t n;memcpy(&n,p,4);return n;}
+static float SG_DEFloat(const unsigned char *p){float n;memcpy(&n,p,4);return n;}
+static int SG_DemoEventValid(const unsigned char *b,int size,int maxevents){
+ int i;float v;
+ if(!b || size!=84 || SG_DEInt(b)<0 || SG_DEInt(b)>127 || SG_DEInt(b+4)<1 || SG_DEInt(b+4)>=maxevents)return 0;
+ v=SG_DEFloat(b+8);if(!isfinite(v)||v<0||v>60)return 0;
+ if(SG_DEInt(b+12)<0||SG_DEInt(b+12)>3||SG_DEInt(b+16)<1||SG_DEInt(b+16)>32||SG_DEInt(b+56)<0||SG_DEInt(b+56)>1)return 0;
+ for(i=0;i<9;i++){v=SG_DEFloat(b+20+i*4);if(!isfinite(v)||fabsf(v)>((i>=3&&i<6)?360000.0f:131072.0f))return 0;}
+ for(i=0;i<2;i++){v=SG_DEFloat(b+60+i*4);if(!isfinite(v)||fabsf(v)>131072.0f)return 0;}
+ if(SG_DEInt(b+68)<-65535||SG_DEInt(b+68)>65535||SG_DEInt(b+72)<-65535||SG_DEInt(b+72)>65535)return 0;
+ if(SG_DEInt(b+76)<0||SG_DEInt(b+76)>1||SG_DEInt(b+80)<0||SG_DEInt(b+80)>1)return 0;
+ return 1;
+}
+static int SG_DemoSoundName(const unsigned char *b,int size){
+ int i,n,start=0;unsigned char c;
+ if(!b||size<1||size>255)return 0;
+ for(n=0;n<size&&b[n];n++){ }if(n<1)return 0;
+ if(b[0]=='!'){for(i=1;i<n;i++){c=b[i];if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'))return 0;}return n>1;}
+ for(i=0;i<=n;i++){
+  c=i<n?b[i]:'/';
+  if(c=='/'){if(i==start||(i-start==1&&b[start]=='.')||(i-start==2&&b[start]=='.'&&b[start+1]=='.'))return 0;start=i+1;continue;}
+  if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'||c=='-'||c=='.'||c==' '||c=='@'||c=='('||c==')'||c=='['||c==']'))return 0;
+ }
+ return 1;
+}
+static int SG_DemoSoundValues(int channel,float attn,float volume,int flags,int pitch){
+ return channel>=0&&channel<=7&&isfinite(attn)&&attn>=0&&attn<=4&&isfinite(volume)&&volume>=0&&volume<=1&&flags>=0&&flags<=2047&&pitch>=1&&pitch<=255;
+}
+#endif
