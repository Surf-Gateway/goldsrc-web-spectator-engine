diff --git a/engine/studio.h b/engine/studio.h
index 692a1d3..3c6ac52 100644
--- a/engine/studio.h
+++ b/engine/studio.h
@@ -91,6 +91,14 @@ Studio models are position independent, so the cache manager can move them.
 #define STUDIO_NF_COLORMAP		(1U<<30)	// internal system flag
 #define STUDIO_NF_UV_COORDS		(1U<<31)	// using half-float coords instead of ST
 
+// Pixels stored at the header size shifted right by this field (1-3); the
+// header width/height remain the texture-coordinate basis. Written only by
+// the spectator's reduced-texture asset variant.
+#define SG_STUDIO_NF_STORED_SHIFT_BIT	24
+#define SG_STUDIO_NF_STORED_SHIFT_MASK	(3U<<SG_STUDIO_NF_STORED_SHIFT_BIT)
+#define SG_STUDIO_STORED_SHIFT( flags )	((((unsigned int)(flags)) & SG_STUDIO_NF_STORED_SHIFT_MASK) >> SG_STUDIO_NF_STORED_SHIFT_BIT)
+#define SG_STUDIO_STORED_SIDE( side, flags )	((( side ) >> SG_STUDIO_STORED_SHIFT( flags )) > 0 ? (( side ) >> SG_STUDIO_STORED_SHIFT( flags )) : 1 )
+
 // motion flags
 #define STUDIO_X			0x0001
 #define STUDIO_Y			0x0002
